# Odysseus Engine - Variables de Entorno
# Copia este archivo a .env y modifica los valores según tu entorno

# Puerto HTTP del servidor (puerto interno del contenedor)
PORT=3000

# Clave API para autenticación en /v1/extract
# IMPORTANTE: Cambia esto en producción por una clave segura y aleatoria
# Genera una con: openssl rand -hex 32
API_KEY=change-me-in-production

# Nivel de logging (trace, debug, info, warn, error)
RUST_LOG=info

# Proxies rotativos (opcional)
# Formato: lista separada por comas de URLs de proxy
# Ejemplos: http://proxy1:8080,http://proxy2:8080
#           socks5://user:pass@proxy1:1080,socks5://proxy2:1080
# PROXIES=http://proxy1:8080,http://proxy2:8080

# Opcional: Configuración de la caché (valores por defecto en el código)
# CACHE_MAX_CAPACITY=10000
# CACHE_TTL_SECONDS=300
# CACHE_TTI_SECONDS=60

# Opcional: Configuración de timeout HTTP (segundos)
# HTTP_TIMEOUT_SECONDS=10